{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tccrpg",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-26",
  "d1_databases": [
    {
      "binding": "TCC_DB",
      "database_name": "tcc-portal-production",
      "database_id": "9cec6c83-8d26-480a-a260-cb5b954900f7"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "TCC_DB",
          "database_name": "tcc-portal-preview",
          "database_id": "b5b6a8e1-72e1-4946-a2d9-989675be6dbd"
        }
      ]
    }
  }
}
