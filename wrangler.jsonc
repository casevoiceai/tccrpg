{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tccrpg",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "triggers": { "crons": ["17 6 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "TCC_DB",
      "database_name": "tcc-portal-production",
      "database_id": "9cec6c83-8d26-480a-a260-cb5b954900f7"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TCC_REVIEW_MATERIALS",
      "id": "4a51ac6fcd6246d89b1685b80a20315e"
    }
  ],
  "env": {
    "preview": {
      "name": "tccrpg-preview",
      "d1_databases": [
        {
          "binding": "TCC_DB",
          "database_name": "tcc-portal-preview",
          "database_id": "b5b6a8e1-72e1-4946-a2d9-989675be6dbd"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "TCC_REVIEW_MATERIALS",
          "id": "efc9ca373c9545f08823f70c4706aa7f"
        }
      ]
    }
  }
}
